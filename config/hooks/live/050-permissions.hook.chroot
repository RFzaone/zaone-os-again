#!/bin/sh
set -eu

groupadd -f zaone-setup
mkdir -p /etc/zaone/pins /var/lib/zaone
chmod 700 /etc/zaone/pins

chown root:root \
  /usr/lib/zaone/setup-helper \
  /usr/lib/zaone/pam-pin-auth

chmod 755 \
  /usr/lib/zaone/setup-helper \
  /usr/lib/zaone/pam-pin-auth

chmod 644 \
  /etc/polkit-1/rules.d/49-zaone-setup.rules \
  /usr/share/polkit-1/actions/org.zaone.setup.policy \
  /etc/pam.d/zaone-auth

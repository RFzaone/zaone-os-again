#!/bin/sh
set -eu

groupadd -f zaone-setup
mkdir -p /var/lib/zaone /etc/zaone/pins
chmod 700 /etc/zaone/pins

if id zaone >/dev/null 2>&1; then
  for group in sudo audio video plugdev netdev bluetooth lp scanner zaone-setup; do
    getent group "$group" >/dev/null 2>&1 && usermod -aG "$group" zaone || true
  done
  passwd -d zaone >/dev/null 2>&1 || true
  mkdir -p /home/zaone/Desktop
  cp /usr/share/applications/zaone-install.desktop /home/zaone/Desktop/ 2>/dev/null || true
  chmod 755 /home/zaone/Desktop/zaone-install.desktop 2>/dev/null || true
  chown -R zaone:zaone /home/zaone
fi

exit 0

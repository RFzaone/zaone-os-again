#!/usr/bin/env bash
set -Eeuo pipefail

mode="${1:-}"

if [[ "$mode" == "--apply-saved" ]]; then
  mode="$(cat "$HOME/.config/zaone/theme" 2>/dev/null || echo dark)"
elif [[ "$mode" == "--choose" ]]; then
  selected="$(zenity --list --radiolist \
    --title='Zaone Appearance' \
    --text='Choose your system appearance' \
    --column='' --column='Mode' \
    TRUE Dark FALSE Light 2>/dev/null)" || exit 0
  mode="$(tr '[:upper:]' '[:lower:]' <<<"$selected")"
fi

case "$mode" in
  dark)
    gtk_theme="Adwaita-dark"
    icon_theme="Papirus-Dark"
    wallpaper="/usr/share/backgrounds/zaone/zaone-wallpaper.png"
    prefer_dark=true
    ;;
  light)
    gtk_theme="Adwaita"
    icon_theme="Papirus-Light"
    wallpaper="/usr/share/backgrounds/zaone/zaone-wallpaper-light.png"
    prefer_dark=false
    ;;
  *)
    echo "Usage: zaone-theme dark|light|--choose|--apply-saved" >&2
    exit 2
    ;;
esac

mkdir -p "$HOME/.config/zaone" "$HOME/.config/gtk-3.0"
printf '%s\n' "$mode" >"$HOME/.config/zaone/theme"

cat >"$HOME/.config/gtk-3.0/settings.ini" <<EOF
[Settings]
gtk-theme-name=$gtk_theme
gtk-icon-theme-name=$icon_theme
gtk-font-name=Noto Sans 10
gtk-application-prefer-dark-theme=$prefer_dark
EOF

if command -v xfconf-query >/dev/null 2>&1; then
  xfconf-query -c xsettings -p /Net/ThemeName -n -t string -s "$gtk_theme" || true
  xfconf-query -c xsettings -p /Net/IconThemeName -n -t string -s "$icon_theme" || true

  monitor="$(xrandr --query 2>/dev/null | awk '/ connected primary/{print $1; exit} / connected/{fallback=$1} END{if (fallback) print fallback}' | head -n1)"
  monitor="${monitor:-monitor0}"
  base="/backdrop/screen0/monitor${monitor}/workspace0"
  xfconf-query -c xfce4-desktop -p "$base/last-image" -n -t string -s "$wallpaper" || true
  xfconf-query -c xfce4-desktop -p "$base/image-style" -n -t int -s 5 || true

  while IFS= read -r prop; do
    xfconf-query -c xfce4-desktop -p "$prop" -s "$wallpaper" || true
  done < <(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep '/last-image$' || true)

  xfdesktop --reload >/dev/null 2>&1 || true
fi

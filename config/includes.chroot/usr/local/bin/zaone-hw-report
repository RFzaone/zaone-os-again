#!/usr/bin/env bash
set -u

out="$HOME/zaone-hardware-report-$(date +%Y%m%d-%H%M%S).txt"

{
  echo "Zaone OS V2 hardware report"
  echo "Generated: $(date -Is)"
  echo
  echo "== OS =="
  cat /etc/os-release
  uname -a
  echo
  echo "== DMI =="
  sudo dmidecode -t system -t baseboard 2>/dev/null || true
  echo
  echo "== PCI drivers =="
  lspci -nnk
  echo
  echo "== USB =="
  lsusb
  echo
  echo "== Input, touchscreen, and pen =="
  libinput list-devices 2>/dev/null || true
  echo
  echo "== Network and Bluetooth =="
  nmcli device 2>/dev/null || true
  rfkill list 2>/dev/null || true
  echo
  echo "== Audio =="
  wpctl status 2>/dev/null || true
  aplay -l 2>/dev/null || true
  echo
  echo "== Cameras =="
  v4l2-ctl --list-devices 2>/dev/null || true
  cam -l 2>/dev/null || true
  echo
  echo "== Sensors =="
  busctl --system tree net.hadess.SensorProxy 2>/dev/null || true
  echo
  echo "== Firmware and driver warnings =="
  journalctl -b -k --no-pager 2>/dev/null |
    grep -Ei 'firmware|failed|error|iwlwifi|sof|i915|xe|ipu|touch|wacom' |
    tail -n 300 || true
} >"$out"

echo "Saved: $out"

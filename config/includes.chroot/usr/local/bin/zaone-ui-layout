#!/usr/bin/env bash
set -u
sleep 2

read -r width height < <(xrandr --current 2>/dev/null | awk '/ connected primary/{split($3,a,"+"); split(a[1],r,"x"); print r[1],r[2]; exit} / connected/{split($3,a,"+"); split(a[1],r,"x"); if (!seen) { print r[1],r[2]; seen=1; exit }}')
width="${width:-1920}"
height="${height:-1080}"

# 125% style scale
xfconf-query -c xsettings -p /Xft/DPI -n -t int -s 122880 >/dev/null 2>&1 || xfconf-query -c xsettings -p /Xft/DPI -t int -s 122880 >/dev/null 2>&1 || true
xfconf-query -c xsettings -p /Gtk/FontName -n -t string -s 'Noto Sans 10' >/dev/null 2>&1 || xfconf-query -c xsettings -p /Gtk/FontName -t string -s 'Noto Sans 10' >/dev/null 2>&1 || true
xfconf-query -c xsettings -p /Gtk/MonospaceFontName -n -t string -s 'Noto Sans Mono 10' >/dev/null 2>&1 || xfconf-query -c xsettings -p /Gtk/MonospaceFontName -t string -s 'Noto Sans Mono 10' >/dev/null 2>&1 || true

# Panel metrics tuned for a 1080p Windows-like feel
panel_size=44
if [ "$height" -ge 1440 ]; then
  panel_size=52
elif [ "$height" -le 900 ]; then
  panel_size=40
fi
panel_y=$((height - 30))
center_x=$((width / 2))

xfconf-query -c xfce4-panel -p /panels/panel-1/size -n -t int -s "$panel_size" >/dev/null 2>&1 || xfconf-query -c xfce4-panel -p /panels/panel-1/size -t int -s "$panel_size" >/dev/null 2>&1 || true
xfconf-query -c xfce4-panel -p /panels/panel-1/position -n -t string -s "p=8;x=${center_x};y=${panel_y}" >/dev/null 2>&1 || xfconf-query -c xfce4-panel -p /panels/panel-1/position -t string -s "p=8;x=${center_x};y=${panel_y}" >/dev/null 2>&1 || true
xfconf-query -c xfce4-panel -p /panels/panel-1/length -n -t int -s 58 >/dev/null 2>&1 || xfconf-query -c xfce4-panel -p /panels/panel-1/length -t int -s 58 >/dev/null 2>&1 || true
xfconf-query -c xfce4-panel -p /panels/panel-1/background-style -n -t int -s 0 >/dev/null 2>&1 || xfconf-query -c xfce4-panel -p /panels/panel-1/background-style -t int -s 0 >/dev/null 2>&1 || true

xfce4-panel --restart >/dev/null 2>&1 &

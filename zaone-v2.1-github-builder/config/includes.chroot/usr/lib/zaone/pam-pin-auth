#!/usr/bin/env python3
import os
import re
import sys
from pathlib import Path

from argon2 import PasswordHasher
from argon2.exceptions import VerifyMismatchError, VerificationError

def fail() -> None:
    raise SystemExit(1)

if os.geteuid() != 0 or os.environ.get("PAM_TYPE") != "auth":
    fail()

username = os.environ.get("PAM_USER", "")
if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", username):
    fail()

token = (
    sys.stdin.buffer.read(1024)
    .replace(b"\x00", b"")
    .decode("utf-8", "ignore")
    .strip()
)
if not re.fullmatch(r"\d{4,8}", token):
    fail()

hash_path = Path("/etc/zaone/pins") / f"{username}.argon2"
try:
    encoded = hash_path.read_text(encoding="utf-8").strip()
except OSError:
    fail()

try:
    if PasswordHasher().verify(encoded, token):
        raise SystemExit(0)
except (VerifyMismatchError, VerificationError, ValueError):
    pass

fail()

#!/usr/bin/env bash
set -u

command -v monitor-sensor >/dev/null 2>&1 || exit 0
command -v xrandr >/dev/null 2>&1 || exit 0
command -v xinput >/dev/null 2>&1 || exit 0

display="$(xrandr --query 2>/dev/null | awk '/ connected primary/{print $1; exit} / connected/{fallback=$1} END{if (fallback) print fallback}' | head -n1)"
[[ -n "$display" ]] || exit 0

apply_rotation() {
  local orientation="$1" rotation matrix
  case "$orientation" in
    normal)
      rotation="normal"; matrix="1 0 0 0 1 0 0 0 1" ;;
    left-up)
      rotation="left"; matrix="0 -1 1 1 0 0 0 0 1" ;;
    right-up)
      rotation="right"; matrix="0 1 0 -1 0 1 0 0 1" ;;
    bottom-up)
      rotation="inverted"; matrix="-1 0 1 0 -1 1 0 0 1" ;;
    *)
      return ;;
  esac

  xrandr --output "$display" --rotate "$rotation" || return

  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    name="$(xinput list --name-only "$id" 2>/dev/null || true)"
    if grep -Eqi 'touch|pen|stylus' <<<"$name"; then
      xinput set-prop "$id" "Coordinate Transformation Matrix" $matrix >/dev/null 2>&1 || true
    fi
  done < <(xinput list --id-only 2>/dev/null)
}

monitor-sensor 2>/dev/null | while IFS= read -r line; do
  case "$line" in
    *"Accelerometer orientation changed:"*)
      apply_rotation "${line##*: }"
      ;;
  esac
done
